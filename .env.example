# "mock" usa dados em memória/localStorage (sem backend). "http" chama a API real.
VITE_API_MODE=mock
# Base da API quando VITE_API_MODE=http. Em dev, "/api" passa pelo proxy do Vite.
VITE_API_BASE_URL=/api
# Destino do proxy do Vite em desenvolvimento.
VITE_PROXY_TARGET=http://localhost:3000
# Tiles do mapa (opcional). Vazio = OpenStreetMap, ok para dev mas não para produção com tráfego.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
